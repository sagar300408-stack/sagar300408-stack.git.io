{
  "version": 2,
  "buildCommand": "npm run build",
  "rewrites": [
    {
      "source": "/assets/:path*",
      "has": [{ "type": "host", "value": "app.originyx.in" }],
      "destination": "/app/assets/:path*"
    },
    {
      "source": "/:file(.*\\.(?:png|svg|ico|jpg|jpeg|webp|woff|woff2|ttf|json|css|js|map))",
      "has": [{ "type": "host", "value": "app.originyx.in" }],
      "destination": "/app/:file"
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "app.originyx.in" }],
      "destination": "/app/index.html"
    },
    {
      "source": "/home",
      "destination": "/index.html"
    },
    {
      "source": "/home/",
      "destination": "/index.html"
    },
    {
      "source": "/admin(.*)",
      "destination": "/admin/index.html"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "missing": [
        {
          "type": "host",
          "value": "app.originyx.in"
        }
      ],
      "destination": "/home",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self' 'unsafe-inline' 'unsafe-eval' https: data: blob:;"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains; preload"
        }
      ]
    }
  ]
}
